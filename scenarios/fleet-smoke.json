{
  "name": "fleet-smoke",
  "kind": "fleet",
  "tenants": 10,
  "working_set": 3,
  "max_attached": 4,
  "idle_secs": 60,
  "shared_buffers": "16MB",
  "clients": 4,
  "duration": 30,
  "warmup": 5,
  "rate": 40,
  "hold": 180,
  "sample_secs": 10,
  "settle_secs": 30,
  "drain_secs": 30,
  "setup": "fleet-tenant.sql",
  "requests": [
    {
      "name": "row-by-pk",
      "path": "/bench_rows?id=eq.{{rand:1:100}}&select=id,title,done",
      "auth": "user",
      "weight": 5
    },
    {
      "name": "page-of-20",
      "path": "/bench_rows?select=id,title,done&order=id.desc&limit=20",
      "auth": "user",
      "weight": 3
    }
  ]
}
