{
  "name": "rest-warm-reads",
  "kind": "rest",
  "clients": 8,
  "duration": 60,
  "warmup": 15,
  "setup": "rest-demo.sql",
  "requests": [
    {
      "name": "row-by-pk",
      "path": "/bench_todos?id=eq.{{rand:1:20000}}&select=id,title,done",
      "auth": "user",
      "weight": 4
    },
    {
      "name": "page-of-20",
      "path": "/bench_todos?select=id,title,done&order=id.desc&limit=20",
      "auth": "user",
      "weight": 3
    },
    {
      "name": "filtered-page",
      "path": "/bench_todos?done=is.false&list=eq.{{rand:1:200}}&select=id,title&order=id&limit=20",
      "auth": "user",
      "weight": 2
    },
    {
      "name": "embed-lists-todos",
      "path": "/bench_lists?select=id,name,bench_todos(id,title)&limit=10",
      "auth": "user",
      "weight": 1
    },
    {
      "name": "count-exact",
      "path": "/bench_todos?select=id&limit=1",
      "auth": "user",
      "header": { "prefer": "count=exact" },
      "expect": 206,
      "weight": 1
    },
    {
      "name": "rpc-stats",
      "method": "POST",
      "path": "/rpc/bench_todo_stats",
      "body": "{}",
      "auth": "user",
      "weight": 1
    },
    {
      "name": "anon-notes",
      "path": "/bench_notes?select=id,title&order=id&limit=20",
      "auth": "anon",
      "weight": 2
    }
  ]
}
